# Copy to .env.local and adjust. Only VITE_-prefixed values are exposed to the browser.
# Never place private API keys here — anything in a Vite env file ships to the client.

# Base URL of the future recruitment backend (leave empty to run on the local mock layer)
VITE_API_BASE_URL=

# "true" keeps the app on the in-browser mock data layer (src/services/mockDb.js)
VITE_USE_MOCK_API=true

# Base URL of a backend proxy for AI features. The proxy holds the AI provider key — never the frontend.
VITE_AI_PROXY_URL=
