# Copy to .env.local and fill in. Only VITE_-prefixed values reach the browser bundle.
# Never put private keys here (AI provider keys, Supabase service-role key, email provider keys):
# those belong in Supabase Edge Function secrets (see docs/deployment.md).

# Product branding (optional)
VITE_PRODUCT_NAME=PeopleOS
VITE_PRODUCT_TAGLINE=The intelligent workspace for people operations.

# Supabase project (public URL and anon key). Leave both empty to run the demo workspace.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Deployed URL of the `assistant` Edge Function. Leave empty to use the labelled demo assistant.
VITE_ASSISTANT_URL=
